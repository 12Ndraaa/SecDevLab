    "Html": "\n\n    <div class=\"container-buttons-left\">\n        <a class=\"button-orange\" href=\"/academy/labs/launch/d9a071d8264e85184722707ff5747bbbd77963967d1d01f1b22f5dd8252f9767?referrer=%2fweb-security%2fsql-injection%2flab-retrieve-hidden-data\" target=\"_blank\">\n            <span class=\"icon-erlenmeyer\"></span>ACCESS THE LAB\n        </a>\n    </div>\n    <noscript><p class=\"no-script-lab-warning\">Launching labs may take some time, please hold on while we build your environment.</p></noscript>\n\n\n<div class=\"hidden pageloadingmask\">\n    <div class=\"cube-spin-canvas\">\n    <div class=\"cube-spin\">\n        <div class=\"face face--ft\"></div>\n        <div class=\"face face--bk\"></div>\n        <div class=\"face face--lt\"></div>\n        <div class=\"face face--rt\"></div>\n        <div class=\"face face--tp\"></div>\n        <div class=\"face face--bt\"></div>\n    </div>\n</div>\n</div>",
