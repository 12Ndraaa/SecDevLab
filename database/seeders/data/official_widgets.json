    "WidgetId": "academy-accountstatus",
    "Html": "\n<input class=\"hidden\" id=\"trackerpopup\" type=\"checkbox\">\n<div class=\"widgetcontainer-box is-twobtns academy-account-status pin-to-bottom is-logged-out\" id=\"AcademyAccountStatusWidget\">\n        <p class=\"hidden-when-collapsed\">Want to track your progress and have a more personalized learning experience? (It's free!)</p>\n        <div class=\"flex-center\">\n            <a class=\"button-orange-small\" href=\"/users/register\">Sign up</a>\n            <a class=\"button-white-small\" href=\"/users?returnurl=%2fweb-security%2fsql-injection%2flab-retrieve-hidden-data\">Login</a>\n        </div>\n</div>\n\n",
