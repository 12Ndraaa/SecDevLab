server {
    listen 0.0.0.0:__PORT__ default_server;
    listen [::]:__PORT__ default_server;
    server_name _;

    root /var/www/html/public;
    index index.php;

    charset utf-8;
    client_max_body_size 16M;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    add_header X-Content-Type-Options "nosniff" always;

    location = /favicon.ico {
        access_log off;
        log_not_found off;
        try_files $uri /index.php?$query_string;
    }

    location = /robots.txt {
        access_log off;
        log_not_found off;
        try_files $uri /index.php?$query_string;
    }

    # Block top-level dotfiles like /.htaccess and /.env/ while keeping /lab/{token}/.../.htaccess functional.
    location ~ ^/\.(?!well-known) {
        deny all;
    }

    # Route root and trailing-slash URLs directly to Laravel even when matching
    # directories (e.g. /web-security/csrf/) exist under public/ for static images.
    location = / {
        try_files /__laravel_front_controller__ /index.php?$query_string;
    }

    location ~ ^.+/$ {
        try_files /__laravel_front_controller__ /index.php?$query_string;
    }

    # Serve real static files directly; route everything else (including extensionless
    # directory names like /web-security/dashboard and virtual /lab/{token}/*.php paths) to Laravel.
    location / {
        try_files $uri /index.php?$query_string;
    }

    # Only execute public/index.php through PHP-FPM so virtual lab PHP paths
    # under /lab/{token}/.../exploit.php always reach Laravel's SandboxedPhpEvaluator.
    location = /index.php {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_read_timeout 600s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }
}
